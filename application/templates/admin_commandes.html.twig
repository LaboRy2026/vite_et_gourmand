<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Administration - Vite & Gourmand</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background-color: #fffaf3;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background-color: #6b2638;
        }

        h1 {
            color: #6b2638;
            font-family: Georgia, serif;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-dark">
    <div class="container">
        <span class="navbar-brand">
            Vite & Gourmand — Administration
        </span>
    </div>
</nav>

<main class="container py-5">
    <h1 class="mb-4">Gestion des commandes</h1>
{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}

{% for message in app.flashes('danger') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}

    <div class="alert alert-info">
        Interface de démonstration — accès administrateur
        à sécuriser avant toute utilisation.
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Client</th>
                    <th>Menu</th>
                    <th>Date</th>
                    <th>Personnes</th>
                    <th>Prix</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td>{{ commande.id_commande }}</td>
                        <td>
                            {{ commande.prenom }}
                            {{ commande.nom }}
                        </td>
                        <td>{{ commande.menu }}</td>
                        <td>{{ commande.date_prestation }}</td>
                        <td>{{ commande.nombre_personnes }}</td>
                        <td>{{ commande.prix_total }} €</td>
                        
<td>
    <form method="post"
          action="{{ path('app_admin_commandes') }}">

        <input type="hidden"
               name="id_commande"
               value="{{ commande.id_commande }}">

        <input type="hidden"
               name="_token"
               value="{{ csrf_token('statut_' ~ commande.id_commande) }}">

        <select name="statut" class="form-select form-select-sm mb-2">
            {% for valeur, libelle in {
                'en_attente': 'En attente',
                'acceptee': 'Acceptée',
                'en_preparation': 'En préparation',
                'terminee': 'Terminée',
                'annulee': 'Annulée'
            } %}
                <option value="{{ valeur }}"
                    {% if commande.statut == valeur %}selected{% endif %}>
                    {{ libelle }}
                </option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-sm btn-primary">
            Enregistrer
        </button>
    </form>
</td>

                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">
                            Aucune commande enregistrée.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>

{% include '_footer.html.twig' %}
</body>
</html>
