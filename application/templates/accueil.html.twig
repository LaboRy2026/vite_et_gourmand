
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Vite & Gourmand - Traiteur à Bordeaux</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background-color: #fffaf3;
            color: #333;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background-color: #6b2638;
        }

        .navbar-brand,
        .nav-link {
            color: white !important;
        }

        .hero {
            background: #f5e9dc;
            padding: 100px 20px;
            text-align: center;
        }

        .hero h1 {
            color: #6b2638;
            font-family: Georgia, serif;
            font-size: 3rem;
        }

        .btn-gourmand {
            background-color: #6b2638;
            color: white;
            padding: 12px 30px;
        }

        .btn-gourmand:hover {
            background-color: #501b29;
            color: white;
        }

        .section-title {
            color: #6b2638;
            font-family: Georgia, serif;
        }

        footer {
            background-color: #6b2638;
            color: white;
            padding: 25px;
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                Vite & Gourmand
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navigation"
                    aria-controls="navigation"
                    aria-expanded="false"
                    aria-label="Afficher la navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse"
                 id="navigation">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_menus') }}">Nos menus</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Présentation -->
    <section class="hero">
        <div class="container">
            <h1>Bienvenue chez Vite & Gourmand</h1>

            <p class="lead mt-4">
                Votre traiteur à Bordeaux pour tous
                vos événements gourmands.
            </p>

            <p>
                Des menus savoureux, préparés avec soin
                pour partager de beaux moments.
            </p>

            <a href="{{ path('app_menus') }}"
               class="btn btn-gourmand mt-3">
                Découvrir nos menus
            </a>
        </div>
    </section>

    <!-- Les menus -->
    <section id="menus" class="container py-5">
        <h2 class="section-title text-center mb-4">
            Nos menus
        </h2>

        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body text-center p-4">
                        <h3 class="card-title">
                            Menu de Noël Tradition
                        </h3>

                        <p class="card-text">
                            Une sélection festive pour
                            vos repas de fin d'année.
                        </p>

                        <p>
                            <strong>
                                À partir de 180 € pour 6 personnes
                            </strong>
                        </p>

                        <span class="badge text-bg-secondary">
                            Menu de démonstration
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="container py-5 text-center">
        <h2 class="section-title">Nous contacter</h2>

        <p>
            Une question concernant nos prestations ?
        </p>

        <p>
            Retrouvez prochainement notre formulaire
            de contact.
        </p>
    </section>

<section class="container my-5" aria-labelledby="titre-avis">
    <h2 id="titre-avis" class="text-center mb-4">
        Avis de nos clients
    </h2>

    <p class="text-center text-muted">
        Avis fictifs utilisés pour la démonstration du projet ECF.
    </p>

    {% if avis_valides is not empty %}
        <div class="row g-4">
            {% for avis in avis_valides %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <p class="mb-2" style="color:#b8860b;"
                               aria-label="Note : {{ avis.note }} sur 5">
                                {% for i in 1..5 %}
                                    {{ i <= avis.note ? '★' : '☆' }}
                                {% endfor %}
                            </p>

                            <p class="card-text">
                                {{ avis.commentaire }}
                            </p>

                            <small class="text-muted">
                                Publié le
                                {{ avis.date_avis|date('d/m/Y') }}
                            </small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class="text-center">
            Aucun avis client validé pour le moment.
        </p>
    {% endif %}
</section>
{% include '_footer.html.twig' %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
