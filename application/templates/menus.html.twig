
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Nos menus - Vite & Gourmand</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background-color: #fffaf3;
            font-family: Arial, sans-serif;
            color: #333;
        }

        .navbar, footer {
            background-color: #6b2638;
        }

        .navbar-brand, .nav-link {
            color: white !important;
        }

        h1, h2 {
            font-family: Georgia, serif;
            color: #6b2638;
        }

        .menu-card {
            height: 100%;
            border: none;
            border-radius: 12px;
            overflow: hidden;
        }

        .menu-card .card-body {
            display: flex;
            flex-direction: column;
        }

        .btn-gourmand {
            background-color: #6b2638;
            color: white;
        }

        .btn-gourmand:hover {
            background-color: #501b29;
            color: white;
        }

        footer {
            color: white;
            padding: 25px;
            text-align: center;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_accueil') }}">
            Vite & Gourmand
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navigation"
                aria-controls="navigation"
                aria-expanded="false"
                aria-label="Afficher la navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navigation">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_accueil') }}">
                        Accueil
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="{{ path('app_menus') }}">
                        Nos menus
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_accueil') }}#contact">
                        Contact
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-5">

    <h1 class="text-center mb-3">Découvrez nos menus</h1>

    <p class="text-center mb-5">
        Des menus pour vos fêtes, repas de famille
        et événements professionnels.
    </p>

<section class="card shadow-sm p-4 mb-4" aria-labelledby="titre-filtres">
    <h2 id="titre-filtres" class="h5 mb-3">Rechercher un menu</h2>

    <div class="row g-3">
        <div class="col-md-3">
            <label for="filtre-prix" class="form-label">Prix maximum</label>
            <input type="number" id="filtre-prix" class="form-control"
                   min="0" placeholder="Ex. : 200">
        </div>

        <div class="col-md-3">
            <label for="filtre-theme" class="form-label">Thème</label>
            <select id="filtre-theme" class="form-select">
                <option value="">Tous les thèmes</option>
                <option value="Noël">Noël</option>
                <option value="Mariage">Mariage</option>
                <option value="Toutes occasions">Toutes occasions</option>
            </select>
        </div>

        <div class="col-md-3">
            <label for="filtre-regime" class="form-label">Régime alimentaire</label>
            <select id="filtre-regime" class="form-select">
                <option value="">Tous les régimes</option>
                <option value="Classique">Classique</option>
                <option value="Végétarien">Végétarien</option>
            </select>
        </div>

        <div class="col-md-3">
            <label for="filtre-personnes" class="form-label">Nombre de personnes</label>
            <input type="number" id="filtre-personnes" class="form-control"
                   min="1" placeholder="Ex. : 6">
        </div>
    </div>

    <div class="mt-3">
        <button type="button" id="reinitialiser-filtres"
                class="btn btn-outline-secondary">
            Réinitialiser les filtres
        </button>
    </div>
</section>

<p id="resultat-filtres" class="mb-3" role="status" aria-live="polite"></p>
    <div class="row g-4">

        
<div class="col-md-6 col-lg-4 menu-item"
     data-prix="180"
     data-theme="Noël"
     data-regime="Classique"
     data-personnes="6">
            <article class="card menu-card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Menu de Noël Tradition</h2>

                    <p>
                        Saumon fumé, plat festif et dessert gourmand.
                    </p>

                    <p><strong>180 € pour 6 personnes</strong></p>
                    <p>Thème : Noël</p>
                    <p>Régime : Classique</p>

                    <p class="small text-muted">
                        Commande au moins 72 h à l'avance.
                    </p>

                    <span class="badge text-bg-secondary mb-3">
                        Menu fictif de démonstration
                    </span>

                    
<a href="{{ path('app_menu_detail', {'id': 1}) }}"
   class="btn btn-gourmand mt-auto">
    Voir le détail
</a>

                </div>
            </article>
        </div>

       
<div class="col-md-6 col-lg-4 menu-item"
     data-prix="600"
     data-theme="Mariage"
     data-regime="Classique"
     data-personnes="20">
            <article class="card menu-card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Menu Mariage Élégance</h2>

                    <p>
                        Une sélection raffinée pour célébrer
                        un événement exceptionnel.
                    </p>

                    <p><strong>600 € pour 20 personnes</strong></p>
                    <p>Thème : Mariage</p>
                    <p>Régime : Classique</p>

                    <p class="small text-muted">
                        Réservation à anticiper.
                    </p>

                    <span class="badge text-bg-secondary mb-3">
                        Menu fictif de démonstration
                    </span>

                    
<a href="{{ path('app_menu_detail', {'id': 2}) }}"
   class="btn btn-gourmand mt-auto">
    Voir le détail
</a>

                </div>
            </article>
        </div>

        

<div class="col-md-6 col-lg-4 menu-item"
     data-prix="150"
     data-theme="Toutes occasions"
     data-regime="Végétarien"
     data-personnes="6">
            <article class="card menu-card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Menu Jardin Végétarien</h2>

                    <p>
                        Des recettes végétariennes colorées
                        et gourmandes.
                    </p>

                    <p><strong>150 € pour 6 personnes</strong></p>
                    <p>Thème : Toutes occasions</p>
                    <p>Régime : Végétarien</p>

                    <p class="small text-muted">
                        Disponibilité à confirmer.
                    </p>

                    <span class="badge text-bg-secondary mb-3">
                        Menu fictif de démonstration
                    </span>

                    
<a href="{{ path('app_menu_detail', {'id': 3}) }}"
   class="btn btn-gourmand mt-auto">
    Voir le détail
</a>

                </div>
            </article>
        </div>

    </div>
</main>

<footer>
    <p class="mb-0">
        © 2026 Vite & Gourmand — Projet ECF DWWM
    </p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


{% include '_footer.html.twig' %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    const prix = document.getElementById('filtre-prix');
    const theme = document.getElementById('filtre-theme');
    const regime = document.getElementById('filtre-regime');
    const personnes = document.getElementById('filtre-personnes');
    const boutonReset = document.getElementById('reinitialiser-filtres');
    const resultat = document.getElementById('resultat-filtres');
    const menus = document.querySelectorAll('.menu-item');

    function filtrerMenus() {
        let nombreResultats = 0;

        menus.forEach(function(menu) {
            const prixMenu = Number(menu.dataset.prix);
            const themeMenu = menu.dataset.theme;
            const regimeMenu = menu.dataset.regime;
            const minimumPersonnes = Number(menu.dataset.personnes);

            const prixOK = prix.value === '' ||
                prixMenu <= Number(prix.value);

            const themeOK = theme.value === '' ||
                themeMenu === theme.value;

            const regimeOK = regime.value === '' ||
                regimeMenu === regime.value;

            const personnesOK = personnes.value === '' ||
                minimumPersonnes <= Number(personnes.value);

            const afficher = prixOK && themeOK &&
                regimeOK && personnesOK;

            menu.hidden = !afficher;
            menu.style.display = afficher ? '' : 'none';

            if (afficher) {
                nombreResultats++;
            }
        });

        resultat.textContent = nombreResultats === 0
            ? 'Aucun menu ne correspond à votre recherche.'
            : nombreResultats + ' menu(s) trouvé(s).';
    }

    [prix, theme, regime, personnes].forEach(function(champ) {
        champ.addEventListener('input', filtrerMenus);
        champ.addEventListener('change', filtrerMenus);
    });

    boutonReset.addEventListener('click', function() {
        prix.value = '';
        theme.value = '';
        regime.value = '';
        personnes.value = '';
        filtrerMenus();
    });

    filtrerMenus();
});
</script>
</body>
</html>
